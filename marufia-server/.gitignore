# Configuração privada
.env
.env.*
!.env.example

# Dados persistentes e artefatos operacionais
backups/**
!backups/.gitkeep
logs/**
!logs/.gitkeep
storage/**
!storage/.gitkeep
data/**
supabase/docker/volumes/db/data/**
supabase/docker/volumes/storage/**
supabase/docker/volumes/snippets/**
!supabase/docker/volumes/snippets/.gitkeep

# Credenciais do Cloudflare Tunnel
cloudflare/*-credentials.json
cloudflare/cert.pem
cloudflare/*.key
cloudflare/*.token
cloudflare/*.generated.yaml

# Estado temporário de ferramentas
supabase/.temp/
supabase/.branches/
