# Contrato público inicial da área de infraestrutura.
# Copie para .env somente quando a Fase 3 fornecer as demais variáveis oficiais.
MARUFIA_SERVER_ENV=development
MARUFIA_PUBLIC_URL=http://127.0.0.1:8000
MARUFIA_STUDIO_URL=http://127.0.0.1:3000
MARUFIA_BACKUP_RETENTION_DAYS=7
MARUFIA_BACKUP_RETENTION_WEEKS=4

# Senhas, JWT secret, service_role e credenciais do Tunnel nunca são versionados.
