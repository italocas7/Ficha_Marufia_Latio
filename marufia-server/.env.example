# Marufia Server - modelo seguro. Gere o .env com scripts/setup-environment.ps1.
MARUFIA_SERVER_ENV=development
MARUFIA_PUBLIC_URL=http://127.0.0.1:8000
MARUFIA_STUDIO_URL=http://127.0.0.1:8000
MARUFIA_BACKUP_RETENTION_DAYS=7
MARUFIA_BACKUP_RETENTION_WEEKS=4
CLOUDFLARE_TUNNEL_HOSTNAME=

# Segredos gerados localmente; nunca copie estes placeholders para um servidor em uso.
POSTGRES_PASSWORD=__GENERATE_ON_SETUP__
JWT_SECRET=__GENERATE_ON_SETUP__
ANON_KEY=__GENERATE_ON_SETUP__
SERVICE_ROLE_KEY=__GENERATE_ON_SETUP__
SUPABASE_PUBLISHABLE_KEY=__GENERATE_ON_SETUP__
SUPABASE_SECRET_KEY=__GENERATE_ON_SETUP__
ANON_KEY_ASYMMETRIC=__GENERATE_ON_SETUP__
SERVICE_ROLE_KEY_ASYMMETRIC=__GENERATE_ON_SETUP__
JWT_KEYS=__GENERATE_ON_SETUP__
JWT_JWKS=__GENERATE_ON_SETUP__
DASHBOARD_USERNAME=marufia
DASHBOARD_PASSWORD=__GENERATE_ON_SETUP__
SECRET_KEY_BASE=__GENERATE_ON_SETUP__
REALTIME_DB_ENC_KEY=__GENERATE_ON_SETUP__
VAULT_ENC_KEY=__GENERATE_ON_SETUP__
PG_META_CRYPTO_KEY=__GENERATE_ON_SETUP__
LOGFLARE_PUBLIC_ACCESS_TOKEN=__GENERATE_ON_SETUP__
LOGFLARE_PRIVATE_ACCESS_TOKEN=__GENERATE_ON_SETUP__
S3_PROTOCOL_ACCESS_KEY_ID=__GENERATE_ON_SETUP__
S3_PROTOCOL_ACCESS_KEY_SECRET=__GENERATE_ON_SETUP__
MINIO_ROOT_PASSWORD=__GENERATE_ON_SETUP__

# Enderecos locais nesta fase. O dominio externo sera configurado nas Fases 8-9.
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
API_EXTERNAL_URL=http://127.0.0.1:8000/auth/v1
SITE_URL=https://ficha-marufia-latio.italocas7.chatgpt.site
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:4173,http://localhost:4173

# PostgreSQL e Supavisor (publicados apenas no loopback pelo override Marufia).
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=__GENERATE_ON_SETUP__
POOLER_DB_POOL_SIZE=5

# Studio e API.
STUDIO_DEFAULT_ORGANIZATION=Marufia
STUDIO_DEFAULT_PROJECT=Marufia Server
OPENAI_API_KEY=
JWT_EXPIRY=3600
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
API_GW_HTTP_PORT=8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Auth experimental local. ENABLE_EMAIL_AUTOCONFIRM=true nunca pode ser usado
# quando SUPABASE_PUBLIC_URL for externo; os scripts recusam essa combinação.
# Para acesso pela internet, use false e configure um SMTP real.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
SMTP_ADMIN_EMAIL=admin@localhost.invalid
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Marufia

# Storage local e Edge Functions (Functions ficam desativadas por padrao).
GLOBAL_S3_BUCKET=stub
REGION=local
MINIO_ROOT_USER=supa-storage
STORAGE_TENANT_ID=marufia
FUNCTIONS_VERIFY_JWT=true
IMGPROXY_AUTO_WEBP=true

# Variaveis mantidas para compatibilidade com a distribuicao oficial.
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=
PROXY_DOMAIN=localhost
CERTBOT_EMAIL=admin@localhost.invalid
