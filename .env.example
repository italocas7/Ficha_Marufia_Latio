# Copie este arquivo para .env.local e preencha somente valores públicos.
# Ambientes: development, production ou local.
MARUFIA_BUILD_ENV=local

# Backends: cloud, local ou selfhosted.
MARUFIA_BACKEND_MODE=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Endereço usado em confirmações de conta e no manifesto do aplicativo Windows.
MARUFIA_SITE_URL=http://127.0.0.1:4173

# Nunca adicionar SUPABASE_SECRET_KEY, service_role, JWT secret, senha ou token administrativo.
