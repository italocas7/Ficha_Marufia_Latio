{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "O aplicativo pode abrir somente releases oficiais e ajustar o zoom da própria janela.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/italocas7/Ficha_Marufia_Latio/releases/*"
        }
      ]
    },
    "core:webview:allow-set-webview-zoom"
  ]
}
