{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Marufia Online",
  "version": "0.2.4",
  "identifier": "com.marufia.online",
  "build": {
    "frontendDist": "../dist/client",
    "beforeDevCommand": "node tools/run_site_build.cjs",
    "beforeBuildCommand": "node tools/run_site_build.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Marufia Online Alpha",
        "width": 1280,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "zoomHotkeysEnabled": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; font-src 'self' data:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Marufia Online",
    "category": "RolePlayingGame",
    "shortDescription": "Ficha multiplayer para o sistema Mundo de Marufia.",
    "longDescription": "Aplicativo Windows da ficha Marufia Online, com campanhas, personagens e rolagens multiplayer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Marufia Online"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0NERFODlFNDRCQTlCODYKUldTR203cEVudWhOcEJ6Tk1GZEJJYUs2QkErUkNDNEdHZXpFTkUyd3JPa3FMd0RpUjFaeVhuclUK",
      "endpoints": [
        "https://marufiarpg.org/tauri-update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
